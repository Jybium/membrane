pragma language_version >= 0.23;
import CompactStandardLibrary;


export enum TrialStatusEnum { active, inactive };
export ledger trialCounter: Counter;

struct TrialInfo{
  diseaseCode: Opaque<"string">,
  minAge: Uint<8>,
  maxAge: Uint<8>,
  minPatientSampleCount: Uint<16>,
  status: TrialStatusEnum,
  enrolledCount: Uint<16>,
  researchLabIdHash: Bytes<32>,
  trialIdHash: Bytes<32>,
};

export ledger activeTrials: Map< Bytes<32>, TrialInfo >; // trailIdHash -> TrialInfo
export ledger inactiveTrials: Map< Bytes<32>, TrialInfo >; // trailIdHash -> TrialInfo
export ledger trialsEnrollments: Map< Bytes<32>, Set<Bytes<32>> >; // trailIdHash -> Set<hospitalsIdHashes>


witness getPrivateKey(): Bytes<32>;
witness getPrivateTrialTag(): Bytes<32>; // this is meant to be passed by the research lab when creating a trial  

// this collects the private patients count from the hospital during trial enrollment
witness getHospitalPatientsAggregate(): Uint<16>;


// creates trial for a research lab
export circuit createTrial(
  diseaseCode: Opaque<"string">,
  minAge: Uint<8>,
  maxAge: Uint<8>,
  minPatientSampleCount: Uint<16>,
): Bytes<32>{
  assert(minPatientSampleCount > 0, "minimum patient sample count must be greater than 0");
  assert(maxAge >= minAge, "maximum age must be greater than or equal to minimum age");

  const derivedPublicKey = derivePublicKey(getPrivateKey());
  const derivedTrialTag = derivePrivateTrialTag(getPrivateTrialTag());
  
  const trialIdHash = disclose(derivedTrialTag);

  activeTrials.insert(
    trialIdHash,
    TrialInfo {
      diseaseCode: disclose(diseaseCode),
      minAge: disclose(minAge),
      maxAge: disclose(maxAge),
      minPatientSampleCount: disclose(minPatientSampleCount),
      status: TrialStatusEnum.active,
      enrolledCount: disclose(0),
      researchLabIdHash: disclose(derivedPublicKey),
      trialIdHash: trialIdHash,
    }
  );

  trialCounter += 1;
  return trialIdHash;
}


// this enables an authorized research lab to cancel a trial
export circuit cancelTrial(): Bytes<32> {
  const derivedPublicKey = derivePublicKey(getPrivateKey());
  const derivedTrialTag = derivePrivateTrialTag(getPrivateTrialTag());

  const trialIdHash = disclose(derivedTrialTag);

  assert(activeTrials.member(trialIdHash), "Trial does not exist or has been cancelled");
  const activeTrial = activeTrials.lookup(trialIdHash);
  assert(activeTrial.researchLabIdHash == disclose(derivedPublicKey), "You are not the research lab that created this trial");


  const inactiveTrial = TrialInfo{
    ...activeTrial,
    status: TrialStatusEnum.inactive
  };
  
  inactiveTrials.insert(
    trialIdHash,
    inactiveTrial
  );

  activeTrials.remove(trialIdHash);

  return inactiveTrial.trialIdHash;
}


// enrolls a hospital into an active trial
export circuit trialEnrollment(
  trialIdHash: Bytes<32>,
): Boolean {
  const derivedPublicKey = derivePublicKey(getPrivateKey());
  const patientAggregateCount = getHospitalPatientsAggregate();

  const publicTrialId = disclose(trialIdHash);

  assert(activeTrials.member(publicTrialId), "Trial does not exist or has been cancelled");
  assert(patientAggregateCount >= activeTrials.lookup(publicTrialId).minPatientSampleCount, "Hospital does not meet the minimum patient sample count");

  const hospitalPublicTag = disclose(derivedPublicKey);
  
  // a clinical trial already have existing enrollments
  if(trialsEnrollments.member(publicTrialId)){
    trialsEnrollments.lookup(publicTrialId).insert(hospitalPublicTag);
  } else {

    // if a clinical trial just got its first enrollment
    trialsEnrollments.insert(publicTrialId, default<Set<Bytes<32>>>);
    trialsEnrollments.lookup(publicTrialId).insert(hospitalPublicTag);
  }
  
  // updating trial enrollment count
  const newEnrolledCount: Uint<16> = (activeTrials.lookup(publicTrialId).enrolledCount + 1) as Uint<16>;
  activeTrials.insert(
    publicTrialId, 
    TrialInfo {
      ...activeTrials.lookup(publicTrialId),
      enrolledCount: newEnrolledCount
    }
  );
  return true;
}


// circuit that checks if a trial is active/inactive
export circuit isTrialActive(trialIdHash: Bytes<32>): Boolean {
  const publicTrialId = disclose(trialIdHash);
  return activeTrials.member(publicTrialId);
}


// circuit that gets details for an active clinical trial
export circuit activeTrialDetail(trialIdHash: Bytes<32>): TrialInfo {
  const publicTrialId = disclose(trialIdHash);
  assert(activeTrials.member(publicTrialId), "Trial does not exist or has been cancelled");
  return activeTrials.lookup(publicTrialId);
}


// circuit that gets details for an inactive trial
export circuit inactiveTrialDetail(trialIdHash: Bytes<32>): TrialInfo {
  const publicTrialId = disclose(trialIdHash);
  assert(inactiveTrials.member(publicTrialId), "Trial does not exist or has not been cancelled");
  return inactiveTrials.lookup(publicTrialId);
}


// circuit where a hospital validates to the research lab that they are enrolled in their trial (active/inactive)
export circuit validateTrialEnrollment(
  trialIdHash: Bytes<32>
): Boolean {
  const publicTrialId = disclose(trialIdHash);
  const derivedPublicKey = derivePublicKey(getPrivateKey());
  const hospitalPublicTag = disclose(derivedPublicKey);
  
  assert(trialsEnrollments.member(publicTrialId), "Trial does not exist or has been cancelled");
  assert(trialsEnrollments.lookup(publicTrialId).member(hospitalPublicTag), "Hospital is not enrolled in this trial");
  
  return true;
}




// helper functions
export circuit derivePublicKey(privateKey: Bytes<32>): Bytes<32>{
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "membrane:identity"), privateKey]);
}

export circuit derivePrivateTrialTag(privateKey: Bytes<32>): Bytes<32>{
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "membrane:trialTag"), privateKey]);
}
