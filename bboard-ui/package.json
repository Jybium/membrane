{
  "name": "@midnight-ntwrk/bboard-ui",
  "version": "0.1.0",
  "author": "IOG",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../node_modules/vite/bin/vite.js build --mode preprod",
    "build:preview": "node ../node_modules/vite/bin/vite.js build --mode preview",
    "build:start": "npm run build && npm run start",
    "build:start:preview": "npm run build:preview && npm run start",
    "ci": "npm run typecheck && npm run lint",
    "dev": "node ../node_modules/vite/bin/vite.js",
    "lint": "eslint ./src",
    "start": "http-server --port 0 ./dist",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "node-stdlib-browser": "^1.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-react": "^7.37.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
